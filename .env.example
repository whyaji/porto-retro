NODE_ENV=production
# Site URL
NEXT_PUBLIC_SITE_URL=https://patriaworks.my.id

# Site mode: picks which dataset and copy the whole site renders.
#   personal = Wahyu Patriaji's individual resume (default)
#   company  = Patriaworks, the software house
# Requires a restart/rebuild to take effect (inlined at build time).
NEXT_PUBLIC_SITE_MODE=company
NEXT_PUBLIC_SHOW_PRODUCTS=false

# Own products surfaces (homepage section, Products nav/footer links, /products page).
# Hidden by default; set to true to show them again. Requires company mode.
# NEXT_PUBLIC_SHOW_PRODUCTS=true

# Optional: Facebook App ID (removes fb:app_id warning in Sharing Debugger)
# Create an app at https://developers.facebook.com/ and paste the App ID here
NEXT_PUBLIC_FB_APP_ID=your_facebook_app_id

# Contact Information
# company mode -> inbox@patriaworks.my.id | personal mode -> wahyupatriaji@gmail.com
CONTACT_EMAIL=inbox@patriaworks.my.id

# SMTP Server Configuration (Required for contact form emails in production.
# Without these, production returns HTTP 503 and asks the sender to email directly.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-username@gmail.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM="Patriaworks" <no-reply@patriaworks.my.id>

# Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key_here
TURNSTILE_SECRET_KEY=your_secret_key_here

# Anthropic (Claude): PLANNED, NOT USED YET.
# No AI endpoint is live today. These are documented in advance so the first
# Claude integration ships without new secrets work. Keep the key server-side:
# never prefix it with NEXT_PUBLIC_.
# ANTHROPIC_API_KEY=sk-ant-your-key
# CLAUDE_MODEL=claude-sonnet-4-5
